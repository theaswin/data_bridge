<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Migration Log Form View -->
    <record id="view_migration_log_form" model="ir.ui.view">
        <field name="name">data.bridge.migration.log.form</field>
        <field name="model">data.bridge.migration.log</field>
        <field name="arch" type="xml">
            <form string="Migration Log" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="log_type" widget="badge"
                                   decoration-success="log_type == 'success'"
                                   decoration-warning="log_type == 'warning'"
                                   decoration-danger="log_type == 'error'"
                                   decoration-muted="log_type == 'info'"/>
                        </h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="migration_type" widget="badge"/>
                            <field name="api_migration_id" invisible="migration_type != 'api'"/>
                            <field name="sql_migration_id" invisible="migration_type != 'sql'"/>
                            <field name="migration_date"/>
                            <field name="is_batch_summary"/>
                        </group>
                        <group string="Summary" invisible="not is_batch_summary">
                            <field name="records_created"/>
                            <field name="records_failed"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Source Data" invisible="not source_data">
                        <field name="source_data" nolabel="1" readonly="1" widget="text"/>
                    </group>
                    <group string="Error Details" invisible="not error_details">
                        <div class="alert alert-danger">
                            <field name="error_details" nolabel="1" readonly="1"/>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Migration Log Tree View -->
    <record id="view_migration_log_tree" model="ir.ui.view">
        <field name="name">data.bridge.migration.log.tree</field>
        <field name="model">data.bridge.migration.log</field>
        <field name="arch" type="xml">
            <tree string="Migration Logs" create="false" edit="false"
                  decoration-success="log_type == 'success'"
                  decoration-warning="log_type == 'warning'"
                  decoration-danger="log_type == 'error'"
                  decoration-muted="log_type == 'info'"
                  default_order="migration_date desc">
                <field name="migration_date"/>
                <field name="migration_type" widget="badge"
                       decoration-info="migration_type == 'api'"
                       decoration-primary="migration_type == 'sql'"/>
                <field name="api_migration_id" optional="hide"/>
                <field name="sql_migration_id" optional="hide"/>
                <field name="log_type" widget="badge"
                       decoration-success="log_type == 'success'"
                       decoration-warning="log_type == 'warning'"
                       decoration-danger="log_type == 'error'"
                       decoration-muted="log_type == 'info'"/>
                <field name="message" widget="text"/>
                <field name="is_batch_summary" widget="boolean"/>
                <field name="records_created" optional="show"/>
                <field name="records_failed" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- Migration Log Search View -->
    <record id="view_migration_log_search" model="ir.ui.view">
        <field name="name">data.bridge.migration.log.search</field>
        <field name="model">data.bridge.migration.log</field>
        <field name="arch" type="xml">
            <search string="Search Logs">
                <field name="message"/>
                <field name="api_migration_id"/>
                <field name="sql_migration_id"/>
                <separator/>
                <filter string="Today" name="today" 
                        domain="[('migration_date', '>=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <filter string="This Week" name="week"
                        domain="[('migration_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="API Migrations" name="api" 
                        domain="[('migration_type', '=', 'api')]"/>
                <filter string="SQL Migrations" name="sql" 
                        domain="[('migration_type', '=', 'sql')]"/>
                <separator/>
                <filter string="Success" name="success" domain="[('log_type', '=', 'success')]"/>
                <filter string="Warning" name="warning" domain="[('log_type', '=', 'warning')]"/>
                <filter string="Error" name="error" domain="[('log_type', '=', 'error')]"/>
                <filter string="Info" name="info" domain="[('log_type', '=', 'info')]"/>
                <separator/>
                <filter string="Summaries Only" name="summaries" 
                        domain="[('is_batch_summary', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Log Type" name="group_type" context="{'group_by': 'log_type'}"/>
                    <filter string="Migration Type" name="group_mig_type" 
                            context="{'group_by': 'migration_type'}"/>
                    <filter string="Date" name="group_date" 
                            context="{'group_by': 'migration_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Migration Log Action -->
    <record id="action_migration_log" model="ir.actions.act_window">
        <field name="name">Migration Logs</field>
        <field name="res_model">data.bridge.migration.log</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No migration logs yet
            </p>
            <p>
                Migration logs will appear here after you run a migration.
            </p>
        </field>
    </record>

</odoo>
