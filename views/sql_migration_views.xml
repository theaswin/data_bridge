<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SQL Migration Form View -->
    <record id="view_sql_migration_form" model="ir.ui.view">
        <field name="name">data.bridge.sql.migration.form</field>
        <field name="model">data.bridge.sql.migration</field>
        <field name="arch" type="xml">
            <form string="SQL File Migration">
                <header>
                    <button name="action_parse_file" type="object" 
                            string="Parse SQL File" class="btn-primary"
                            invisible="state not in ['draft', 'error']"
                            icon="fa-file-code-o"/>
                    <button name="action_run_migration" type="object"
                            string="Start Migration" class="btn-success"
                            invisible="state not in ['ready', 'done', 'error']"
                            confirm="This will migrate data from the SQL file. Continue?"
                            icon="fa-play"/>
                    <button name="action_reset" type="object"
                            string="Reset" class="btn-warning"
                            invisible="state in ['draft', 'running']"
                            icon="fa-refresh"/>
                    <button name="action_clear_logs" type="object"
                            string="Clear Logs" class="btn-secondary"
                            invisible="log_count == 0"
                            icon="fa-trash"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,ready,running,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_clear_logs" icon="fa-list-alt"
                                invisible="log_count == 0">
                            <field name="log_count" widget="statinfo" string="Logs"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_clear_logs" icon="fa-exclamation-triangle"
                                invisible="error_count == 0">
                            <field name="error_count" widget="statinfo" string="Errors"/>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Running..." bg_color="bg-info" 
                            invisible="state != 'running'"/>
                    <widget name="web_ribbon" title="Completed" bg_color="bg-success" 
                            invisible="state != 'done'"/>
                    <widget name="web_ribbon" title="Error" bg_color="bg-danger" 
                            invisible="state != 'error'"/>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Migration Name"/>
                        </h1>
                    </div>
                    
                    <!-- Progress Section -->
                    <div class="alert alert-info" role="alert"
                         invisible="state not in ['running', 'done', 'error']">
                        <div class="row">
                            <div class="col-12 mb-2">
                                <strong>Migration Progress</strong>
                                <field name="progress" widget="progressbar" 
                                       options="{'editable': false}"/>
                            </div>
                        </div>
                        <div class="row text-center">
                            <div class="col-md-3">
                                <div class="border rounded p-2 bg-white">
                                    <h4 class="text-success mb-0">
                                        <field name="migrated_records" readonly="1"/>
                                    </h4>
                                    <small class="text-muted">Created</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded p-2 bg-white">
                                    <h4 class="text-danger mb-0">
                                        <field name="failed_records" readonly="1"/>
                                    </h4>
                                    <small class="text-muted">Failed</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded p-2 bg-white">
                                    <h4 class="text-warning mb-0">
                                        <field name="skipped_records" readonly="1"/>
                                    </h4>
                                    <small class="text-muted">Skipped</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded p-2 bg-white">
                                    <h4 class="text-info mb-0">
                                        <field name="records_per_second" readonly="1"/> /s
                                    </h4>
                                    <small class="text-muted">Speed</small>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-2" invisible="state != 'running'">
                            <div class="col-12 text-center">
                                <span class="text-muted">
                                    Batch <field name="current_batch" readonly="1"/> of 
                                    <field name="total_batches" readonly="1"/>
                                </span>
                            </div>
                        </div>
                    </div>
                    
                    <group>
                        <group string="SQL File">
                            <field name="sql_file" filename="sql_filename" 
                                   widget="binary" class="oe_inline"/>
                            <field name="sql_filename" invisible="1"/>
                        </group>
                        <group string="Table Configuration">
                            <field name="source_table" placeholder="customers"/>
                            <field name="destination_model" placeholder="res.partner"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Options">
                            <field name="batch_size"/>
                            <field name="truncate_destination"/>
                            <field name="skip_errors"/>
                        </group>
                        <group string="Statistics">
                            <field name="total_source_records"/>
                            <field name="total_batches"/>
                            <field name="last_migration_date"/>
                            <field name="migration_duration" widget="float_time"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Columns to Migrate" name="included_columns"
                              invisible="not included_columns">
                            <div class="alert alert-success mb-3">
                                <i class="fa fa-check-circle"/> These columns will be migrated:
                            </div>
                            <field name="included_columns" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Excluded Columns" name="excluded_columns"
                              invisible="not excluded_columns">
                            <div class="alert alert-warning mb-3">
                                <i class="fa fa-exclamation-triangle"/> These columns will be skipped:
                            </div>
                            <field name="excluded_columns" readonly="1" nolabel="1"/>
                        </page>
                        <page string="All Detected Columns" name="detected_columns"
                              invisible="not detected_columns">
                            <field name="detected_columns" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Migration Logs" name="logs">
                            <field name="migration_log_ids" readonly="1">
                                <tree decoration-success="log_type == 'success'"
                                      decoration-warning="log_type == 'warning'"
                                      decoration-danger="log_type == 'error'"
                                      decoration-muted="log_type == 'info'"
                                      default_order="migration_date desc">
                                    <field name="migration_date"/>
                                    <field name="log_type" widget="badge"
                                           decoration-success="log_type == 'success'"
                                           decoration-warning="log_type == 'warning'"
                                           decoration-danger="log_type == 'error'"
                                           decoration-muted="log_type == 'info'"/>
                                    <field name="message"/>
                                    <field name="is_batch_summary"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- SQL Migration Tree View -->
    <record id="view_sql_migration_tree" model="ir.ui.view">
        <field name="name">data.bridge.sql.migration.tree</field>
        <field name="model">data.bridge.sql.migration</field>
        <field name="arch" type="xml">
            <tree string="SQL Migrations" decoration-info="state == 'running'"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="sql_filename"/>
                <field name="source_table"/>
                <field name="destination_model"/>
                <field name="total_source_records"/>
                <field name="progress" widget="progressbar"/>
                <field name="migrated_records"/>
                <field name="failed_records" decoration-danger="failed_records > 0"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'done'"
                       decoration-info="state in ['parsed', 'ready', 'running']"
                       decoration-danger="state == 'error'"
                       decoration-muted="state == 'draft'"/>
            </tree>
        </field>
    </record>

    <!-- SQL Migration Kanban View -->
    <record id="view_sql_migration_kanban" model="ir.ui.view">
        <field name="name">data.bridge.sql.migration.kanban</field>
        <field name="model">data.bridge.sql.migration</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="state"/>
                <field name="sql_filename"/>
                <field name="source_table"/>
                <field name="total_source_records"/>
                <field name="migrated_records"/>
                <field name="failed_records"/>
                <field name="progress"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_title">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="o_kanban_record_subtitle text-muted">
                                    <i class="fa fa-file-code-o"/> <field name="sql_filename"/>
                                </div>
                                <div class="text-muted">
                                    <field name="source_table"/> → <field name="destination_model"/>
                                </div>
                                <div class="mt-2">
                                    <field name="progress" widget="progressbar"/>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-4 text-center">
                                        <span class="text-muted">Total</span><br/>
                                        <strong><field name="total_source_records"/></strong>
                                    </div>
                                    <div class="col-4 text-center">
                                        <span class="text-success">Created</span><br/>
                                        <strong class="text-success"><field name="migrated_records"/></strong>
                                    </div>
                                    <div class="col-4 text-center">
                                        <span class="text-danger">Failed</span><br/>
                                        <strong class="text-danger"><field name="failed_records"/></strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- SQL Migration Search View -->
    <record id="view_sql_migration_search" model="ir.ui.view">
        <field name="name">data.bridge.sql.migration.search</field>
        <field name="model">data.bridge.sql.migration</field>
        <field name="arch" type="xml">
            <search string="Search SQL Migrations">
                <field name="name"/>
                <field name="source_table"/>
                <field name="destination_model"/>
                <field name="sql_filename"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Ready" name="ready" domain="[('state', '=', 'ready')]"/>
                <filter string="Running" name="running" domain="[('state', '=', 'running')]"/>
                <filter string="Completed" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Error" name="error" domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter string="Has Errors" name="has_errors" domain="[('failed_records', '>', 0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Destination Model" name="group_dest" 
                            context="{'group_by': 'destination_model'}"/>
                    <filter string="Migration Date" name="group_date"
                            context="{'group_by': 'last_migration_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- SQL Migration Action -->
    <record id="action_sql_migration" model="ir.actions.act_window">
        <field name="name">SQL File Migration</field>
        <field name="res_model">data.bridge.sql.migration</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first SQL file migration
            </p>
            <p>
                Upload a .sql database dump file and migrate data to your Odoo instance.
            </p>
            <p class="text-muted">
                <i class="fa fa-info-circle"/> Many2many and Many2one fields are automatically excluded.
            </p>
        </field>
    </record>

</odoo>
